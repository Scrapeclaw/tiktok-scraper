{
  "actorSpecification": 1,
  "name": "tiktok-profile-scraper",
  "title": "TikTok Profile Scraper & Discovery",
  "description": "Discovers and scrapes TikTok influencer profiles by category and location. Returns follower counts, likes, video views, bio, video thumbnails, and influencer tier — no login required.",
  "version": "1.0",
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Profile Results",
          "transformation": {
            "fields": [
              "username",
              "full_name",
              "followers",
              "following",
              "likes",
              "videos_count",
              "influencer_tier",
              "is_verified",
              "is_private",
              "category",
              "location",
              "scrape_timestamp"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "username":       { "label": "Username",    "format": "text" },
              "full_name":      { "label": "Full Name",   "format": "text" },
              "followers":      { "label": "Followers",   "format": "number" },
              "likes":          { "label": "Likes",       "format": "number" },
              "videos_count":   { "label": "Videos",      "format": "number" },
              "influencer_tier":{ "label": "Tier",        "format": "text" },
              "is_verified":    { "label": "Verified",    "format": "boolean" },
              "category":       { "label": "Category",    "format": "text" },
              "location":       { "label": "Location",    "format": "text" }
            }
          }
        }
      }
    }
  }
}
